# Gbam Core Engine Configuration

# Sports Data API (e.g. API-Football from API-Sports)
SPORTS_DATA_API_KEY=your_api_football_key_here
SPORTS_DATA_API_URL=https://v3.football.api-sports.io

# AI Model API Keys (Gemini for Vision and Reasoning)
GEMINI_API_KEY=your_gemini_api_key_here

# Engine Defaults
MIN_CONFIDENCE_THRESHOLD=0.80
DEFAULT_TARGET_ODDS=10.0
MAX_LEGS_PER_SLIP=30

# Telegram Bot (For Telegram bot layer)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
